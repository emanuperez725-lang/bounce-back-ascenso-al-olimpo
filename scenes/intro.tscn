[node name="Intro" type="Node2D"]
script = ExtResource("1")
cards = Array[String](["Kira y Melina crecieron a la sombra del Olimpo,
donde los dioses miran, pero nunca bajan.", "Una mañana, Melina despertó con los pies de piedra.
La maldición subía, día a día, hacia su corazón.", "El oráculo habló: solo la Manzana de Ambrosía,
que florece en la cima del Olimpo, podía salvarla.", "Kira subió sin descanso.
Llegó tan alto que casi pudo tocarla...", "...y cayó. Hasta el fondo del pantano,
bajo las raíces de la montaña."])
next_scene = "res://scenes/game.tscn"

